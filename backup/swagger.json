    "/auth/resetpassword/{resettoken}": {
      "put": {
        "summary": "Reset password",
        "tags": [
          "Auth"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "resettoken",
            "schema": {
              "type": "string"
